# 依赖与构建产物
node_modules/
dist/
build/
temp/
library/
local/

# 编辑器
.vscode/settings.json
.idea/

# 系统
Thumbs.db
Desktop.ini
.DS_Store

# 测试与截图产物（保留结论文档，不保留体积大的中间产物）
test-results/
playwright-report/
screenshots/**/tmp/

# 本地临时
*.log
.cache/

# 本地临时工作区（截图脚本 / 验证样本 / 三方缓存 / 下载包）
# ⚠️ 这里含只有本机可读的目录（.tmp/aipipe/*），提交会让 clone/push 失败
.tmp/

# Python 缓存
__pycache__/
*.pyc

# 打包分发包（体积大，放 Release / 网盘，不进仓库）
*.zip
# 打包交付物（zip 已忽略，目录整体也不入库）
deliverables/
